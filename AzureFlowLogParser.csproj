<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>azure-flowlog-parser</AssemblyName>
    <!-- Test project lives under tests/ and must not be compiled into the CLI -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;powershell/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageReference Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageReference Include="Azure.ResourceManager.Network" Version="1.17.0" />
    <PackageReference Include="Azure.ResourceManager.Storage" Version="1.8.0" />
    <PackageReference Include="Azure.ResourceManager.Resources" Version="1.12.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="shared\report-template.html" LogicalName="report-template.html" />
  </ItemGroup>

</Project>
